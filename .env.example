# RamsCraft backend configuration. Copy to backend/.env and adjust.
# All values are optional; the defaults are safe (loopback-only, no secrets).

# Port the backend listens on.
PORT=3001

# Interface to bind. Default 127.0.0.1 (loopback only) — intended to sit behind
# nginx/RamsesHub. Set to 0.0.0.0 ONLY together with RAMSCRAFT_API_TOKEN; the
# backend refuses to bind to a public interface without a token.
RAMSCRAFT_HOST=127.0.0.1

# Shared secret required for API + WebSocket access. Leave empty when fronted by a
# reverse proxy that terminates auth (loopback is trusted). Set a long random value
# to expose RamsCraft directly on the network.
RAMSCRAFT_API_TOKEN=

# Comma-separated browser origins allowed via CORS. Empty = same-origin only.
RAMSCRAFT_ALLOWED_ORIGINS=

# Override storage locations if needed (defaults are relative to the backend dir).
# RAMSCRAFT_SERVERS_ROOT=/home/ramzy/ramscraft/servers
# RAMSCRAFT_LOGS_DIR=/home/ramzy/ramscraft/backend/logs
